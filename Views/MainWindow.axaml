<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OutlookApp.ViewModels"
        xmlns:models="using:OutlookApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="OutlookApp.Views.MainWindow"
        x:Name="ThisWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Outlook邮件管理"
        Width="1100" Height="700"
        MinWidth="860" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush">#161B22</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrush">#30363D</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#58A6FF</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessBrush">#3FB950</SolidColorBrush>
        <SolidColorBrush x:Key="DangerBrush">#F85149</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimaryBrush">#E6EDF3</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondaryBrush">#8B949E</SolidColorBrush>
        <SolidColorBrush x:Key="TopBarBrush">#010409</SolidColorBrush>
        <SolidColorBrush x:Key="BtnBgBrush">#21262D</SolidColorBrush>
    </Window.Resources>

    <Grid RowDefinitions="48,*">
        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="16,0">
                <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="&#x1f4e8;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Outlook 邮件管理" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="6,0"/>
                    <Button Content="＋ 导入账号" Command="{Binding ImportAccountCommand}"
                            Background="{StaticResource BtnBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" FontSize="13" Height="32" Padding="14,0"/>
                    <Button Content="⟳ 全部刷新" Command="{Binding RefreshAllCommand}"
                            Background="{StaticResource BtnBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" FontSize="13" Height="32" Padding="14,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                        Background="{StaticResource BtnBgBrush}" CornerRadius="4" Padding="10,4">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" ColumnDefinitions="320,4,*">
            <!-- ===== 左侧：账号列表 ===== -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 账号列表标题 -->
                    <Border DockPanel.Dock="Top" Padding="16,14" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="邮箱账号" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{StaticResource BtnBgBrush}" CornerRadius="10"
                                    Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Accounts.Count, StringFormat={}{0} 个}"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 账号列表 -->
                    <ScrollViewer>
                        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                 BorderThickness="0" Background="Transparent" Margin="8,8,8,0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1C2533"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1C2128"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:EmailAccount">
                                    <Border Padding="12,10" CornerRadius="8"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Background="#0D1117">
                                        <Grid ColumnDefinitions="28,*,130">
                                            <!-- 状态图标 -->
                                            <Border Width="28" Height="28" CornerRadius="14"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayStatus}" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- 邮箱信息 -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Email}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                    <Border Background="{StaticResource BtnBgBrush}" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{Binding AuthType}" FontSize="10"
                                                                   Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding StatusMessage}" FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- 操作按钮 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <Button Content="复制" FontSize="11" Height="26" MinWidth="36" Padding="4,0"
                                                        Background="{StaticResource BtnBgBrush}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        Command="{Binding $parent[Window].DataContext.CopyEmailCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="删除" FontSize="11" Height="26" MinWidth="36" Padding="4,0"
                                                        Background="{StaticResource BtnBgBrush}"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        Command="{Binding $parent[Window].DataContext.DeleteAccountCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="刷新" FontSize="11" Height="26" MinWidth="36" Padding="4,0"
                                                        Background="{StaticResource BtnBgBrush}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        Command="{Binding $parent[Window].DataContext.RefreshAccountCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="#0D1117"/>

            <!-- ===== 右侧：邮件区域 ===== -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,0,Auto"
                  Background="{StaticResource SurfaceBrush}">

                <!-- 搜索栏 -->
                <Border Grid.Row="0" Padding="14,10" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding SearchText}" PlaceholderText="搜索邮件主题、发件人..."
                                 Background="#0D1117" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" FontSize="13" Height="32"/>
                        <Border Grid.Column="1" Margin="10,0,0,0" Background="{StaticResource BtnBgBrush}"
                                CornerRadius="4" Padding="10,0" VerticalAlignment="Center"
                                IsVisible="{Binding HasSelectedAccount}">
                            <TextBlock Text="{Binding SelectedAccount.Email, StringFormat={}{0} 的邮件}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 空状态 -->
                <Border Grid.Row="1" IsVisible="{Binding HasNoSelectedAccount}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="请选择左侧邮箱账号" FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="点击账号查看邮件列表" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                </Border>

                <!-- 邮件列表 -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Emails}" SelectedItem="{Binding SelectedEmail}"
                         BorderThickness="0" Background="Transparent"
                         IsVisible="{Binding HasSelectedAccount}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1C2533"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1C2128"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:EmailMessage">
                            <Border Padding="14,12" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="6,*,Auto">
                                    <!-- 未读标记 -->
                                    <Border Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}"
                                            IsVisible="{Binding IsUnread}" VerticalAlignment="Center"/>
                                    <!-- 邮件内容 -->
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" Margin="10,0,10,0">
                                        <TextBlock Grid.Row="0" Text="{Binding Subject}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding From}"/>  <Run Text="—"/>  <Run Text="{Binding DisplayPreview}"/>
                                        </TextBlock>
                                    </Grid>
                                    <!-- 日期 + 附件 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border Background="#1F2A37" CornerRadius="3" Padding="4,1"
                                                IsVisible="{Binding HasAttachments}">
                                            <TextBlock Text="&#x1f4ce;" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayDate}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 邮件详情 -->
                <Border Grid.Row="3" Padding="20" Background="#0D1117"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        IsVisible="{Binding HasSelectedEmail}" MaxHeight="300">
                    <ScrollViewer>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding SelectedEmail.Subject}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                    Padding="14,12" Margin="0,4,0,0">
                                <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="发件人" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding SelectedEmail.From}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Row="1" Text="收件人" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding SelectedEmail.To}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="2" Text="时间" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding SelectedEmail.DisplayDate}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                                </Grid>
                            </Border>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,4"/>
                            <TextBlock Text="{Binding SelectedEmail.Body}" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" LineHeight="24"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
