<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OutlookApp.ViewModels"
        xmlns:models="using:OutlookApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="OutlookApp.Views.MainWindow"
        x:Name="ThisWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OutlookApp"
        Width="950" Height="650"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,*">
        <Border Grid.Row="0" Background="{DynamicResource SystemAccentColor}">
            <DockPanel LastChildFill="True" Margin="8,0">
                <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left">
                    <Button Content="+ Import Account"
                            Command="{Binding ImportAccountCommand}"
                            Padding="10,4"
                            FontWeight="Bold"/>
                    <Button Content="&#x21bb; Refresh All"
                            Command="{Binding RefreshAllCommand}"
                            Padding="10,4"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="White"
                           Margin="0,0,8,0"
                           FontSize="13"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,Auto,*">
            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemControlPageChromeLowBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,8"
                            Background="{DynamicResource SystemControlPageChromeLowBrush}">
                        <TextBlock Text="Accounts" FontSize="14" FontWeight="Bold"/>
                    </Border>

                    <ListBox ItemsSource="{Binding Accounts}"
                             SelectedItem="{Binding SelectedAccount}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:EmailAccount">
                                <Border Padding="8,6" Margin="2">
                                    <Grid ColumnDefinitions="24,*,90">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayStatus}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Email}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusMessage}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="2">
                                            <Button Content="Copy"
                                                    Command="{Binding $parent[Window].DataContext.CopyEmailCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Copy email"
                                                    FontSize="11"
                                                    Height="22"
                                                    Padding="4,0"/>
                                            <Button Content="Del"
                                                    Command="{Binding $parent[Window].DataContext.DeleteAccountCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Delete account"
                                                    FontSize="11"
                                                    Height="22"
                                                    Padding="4,0"/>
                                            <Button Content="Ref"
                                                    Command="{Binding $parent[Window].DataContext.RefreshAccountCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Refresh emails"
                                                    FontSize="11"
                                                    Height="22"
                                                    Padding="4,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4"
                          Background="{DynamicResource SystemControlPageChromeLowBrush}"/>

            <Grid Grid.Column="2" RowDefinitions="Auto,*,4,Auto">
                <Border Grid.Row="0" Padding="8,6"
                        Background="{DynamicResource SystemControlPageChromeLowBrush}">
                    <TextBox Text="{Binding SearchText}"
                             PlaceholderText="Search emails by subject, sender..."
                             FontSize="13"/>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Emails}"
                         SelectedItem="{Binding SelectedEmail}"
                         BorderThickness="0"
                         Background="Transparent"
                         IsVisible="{Binding HasSelectedAccount}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:EmailMessage">
                            <Border Padding="10,8" Margin="1">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="&#x1f4ce;"
                                               IsVisible="{Binding HasAttachments}"
                                               FontSize="12"
                                               Margin="0,0,6,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Subject}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding DisplayDate}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding DisplayPreview}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="2" Height="4"
                              Background="{DynamicResource SystemControlPageChromeLowBrush}"
                              HorizontalAlignment="Stretch"/>

                <Border Grid.Row="3" Padding="12,8"
                        Background="{DynamicResource SystemControlPageChromeLowBrush}"
                        IsVisible="{Binding HasSelectedEmail}">
                    <ScrollViewer>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding SelectedEmail.Subject}"
                                       FontSize="16" FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <Separator/>
                            <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto"
                                  Margin="0,4,0,8">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="From:" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding SelectedEmail.From}" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Date:" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding SelectedEmail.DisplayDate}" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="To:" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding SelectedEmail.To}" FontSize="12"/>
                            </Grid>
                            <Separator/>
                            <TextBlock Text="{Binding SelectedEmail.Body}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
