<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OutlookApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="380"
        x:Class="OutlookApp.Views.ImportDialog"
        x:Name="ThisDialog"
        x:DataType="vm:ImportDialogViewModel"
        Title="导入邮箱账号"
        Width="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        CanResize="False"
        Background="#0D1117">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush">#161B22</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrush">#30363D</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#58A6FF</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimaryBrush">#E6EDF3</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondaryBrush">#8B949E</SolidColorBrush>
        <SolidColorBrush x:Key="BtnBgBrush">#21262D</SolidColorBrush>
    </Window.Resources>

    <Border Padding="24">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="批量导入邮箱账号"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="一行一个账号，每行 4 项用 ---- 分隔"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,14"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
                <Button Content="取消" Width="80" Height="34"
                        Background="{StaticResource BtnBgBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Click="OnCancelClick"/>
                <Button Content="导入并检测"
                        Width="110" Height="34"
                        Click="OnImportClick"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Spacing="10">
                <Button Content="📁 选择文件"
                        Command="{Binding SelectFileCommand}"
                        Background="{StaticResource BtnBgBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Height="32" Padding="14,0" FontSize="13"
                        HorizontalAlignment="Left"/>

                <TextBox Text="{Binding InputText}"
                         PlaceholderText="粘贴账号，一行一个&#xa;邮箱----密码----clientid----token"
                         MinHeight="80" MaxHeight="160"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#0D1117" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" FontSize="12"
                         CornerRadius="6" Padding="12,8"/>

                <Border Background="#1C2533" CornerRadius="8"
                        Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding HasErrorMessage}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                               Foreground="{StaticResource DangerBrush}"/>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
