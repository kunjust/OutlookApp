<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OutlookApp.ViewModels"
        xmlns:models="using:OutlookApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        x:Class="OutlookApp.Views.ImportDialog"
        x:Name="ThisDialog"
        x:DataType="vm:ImportDialogViewModel"
        Title="导入邮箱账号"
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        CanResize="False"
        Background="#0D1117">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush">#161B22</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrush">#30363D</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#58A6FF</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessBrush">#3FB950</SolidColorBrush>
        <SolidColorBrush x:Key="DangerBrush">#F85149</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimaryBrush">#E6EDF3</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondaryBrush">#8B949E</SolidColorBrush>
    </Window.Resources>

    <Design.DataContext>
        <vm:ImportDialogViewModel/>
    </Design.DataContext>

    <Border Padding="24">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="导入邮箱账号"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                <Button Content="取消"
                        Width="80" Height="34"
                        Background="#21262D"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Click="OnCancelClick"/>
                <Button Content="确认导入"
                        Width="100" Height="34"
                        Command="{Binding ConfirmImportCommand}"
                        IsEnabled="{Binding CanImport}"
                        Click="OnImportClick"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Spacing="10">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                        Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="粘贴账号信息" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="格式：邮箱----密码----clientid----token"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <TextBox Text="{Binding InputText}"
                         PlaceholderText="user@outlook.com----password----client-id----token"
                         MinHeight="70" MaxHeight="120"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#0D1117" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" FontSize="13"
                         CornerRadius="6"
                         Padding="12,8"/>

                <Button Content="检测协议类型"
                        Command="{Binding DetectCommand}"
                        HorizontalAlignment="Left"
                        Background="#21262D"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Height="32" Padding="14,0"
                        FontSize="13"/>

                <ProgressBar IsVisible="{Binding IsDetecting}"
                             IsIndeterminate="True" Height="3"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource BorderBrush}"/>

                <TextBlock Text="{Binding DetectStatus}"
                           FontSize="12" Foreground="{StaticResource AccentBrush}"
                           IsVisible="{Binding IsDetecting}"/>

                <Border Background="#1C2533" CornerRadius="8"
                        Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding HasErrorMessage}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                               Foreground="{StaticResource DangerBrush}"/>
                </Border>

                <Border Background="#1C2533" CornerRadius="8"
                        Padding="14,12" BorderBrush="#3FB950" BorderThickness="1"
                        IsVisible="{Binding HasDetectedAccount}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="检测结果" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="{Binding DetectedAccount.Email}" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding DetectedAccount.StatusMessage}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
